{
  "name": "cg-api-template-hono",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CommonGrants API template built with Hono and the CommonGrants TypeScript SDK",
  "license": "CC0-1.0",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json && cp src/data/opportunities.json dist/data/opportunities.json",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "check:lint": "eslint .",
    "check:format": "prettier --check .",
    "check:types": "tsc --noEmit",
    "checks": "pnpm run check:lint && pnpm run check:format && pnpm run check:types",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit": "pnpm audit --audit-level high",
    "audit:report": "pnpm audit",
    "export:openapi": "tsx scripts/export-openapi.ts",
    "check:spec": "pnpm run export:openapi && cg check spec dist/openapi.json",
    "ci": "pnpm run checks && pnpm run build && pnpm run test:coverage"
  },
  "dependencies": {
    "@common-grants/sdk": "^0.7.2",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@common-grants/cli": "0.4.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.9.2",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/eslint-plugin": "^1.6.25",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^5.0.0"
  }
}
